---
import { noteMark, caseNumbers, caseLabels, caseFiles, caseSecondChips, satelliteCodes } from '../i18n/common';
import type { Dictionary } from '../i18n/types';

interface Props {
  t: Dictionary['cases'];
}

const { t } = Astro.props;
const first = [caseLabels.problem, caseLabels.solution, caseLabels.result];
const second = [caseLabels.task, caseLabels.solution];
---

<p class="kd-note"><b>{noteMark}</b> {t.note}</p>

<div class="kd-term">
  <div class="kd-term__bar"><span>{caseFiles.first}</span><span>{t.nda}</span></div>
  <div class="kd-case">
    <div>
      <p class="kd-case__tag">{caseFiles.tag}</p>
      <h3 class="kd-case__title">{t.first.title}</h3>
      <p class="kd-case__lead">{t.first.lead}</p>
      <div class="kd-case__nums">
        {
          t.first.numLabels.map((label, i) => (
            <div>
              <p class="kd-case__n">{caseNumbers[0][i]}</p>
              <p class="kd-case__nl">{label}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="kd-kv">
      {
        t.first.rows.map((row, i) => (
          <div class="kd-kv__row">
            <span class="kd-kv__key">{first[i]}</span>
            <p class="kd-kv__val">{row}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<article class="kd-entry kd-entry--case">
  <div class="kd-entry__when">{caseFiles.second}</div>
  <div class="kd-entry__main">
    <h3 class="kd-entry__company">{t.second.title}</h3>
    <div class="kd-chips kd-chips--top">
      {caseSecondChips.map((c) => <span class="kd-chip">{c}</span>)}
    </div>
    <div class="kd-kv kd-kv--spaced">
      {
        t.second.rows.map((row, i) => (
          <div class="kd-kv__row">
            <span class="kd-kv__key">{second[i]}</span>
            <p class="kd-kv__val">{row}</p>
          </div>
        ))
      }
    </div>
  </div>
</article>

<div class="kd-sat">
  {
    t.satellites.map((s, i) => (
      <div class="kd-sat__item">
        <p class="kd-sat__code">{satelliteCodes[i]}</p>
        <p class="kd-sat__t">{s.title}</p>
        <p class="kd-sat__d">{s.text}</p>
      </div>
    ))
  }
</div>
