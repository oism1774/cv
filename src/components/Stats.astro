---
import { statNumbers } from '../i18n/common';

interface Props {
  labels: string[];
}

const { labels } = Astro.props;
---

<div class="kd-stats">
  {
    labels.map((label, i) => (
      <div class="kd-stat">
        <p class="kd-stat__n">{statNumbers[i]}</p>
        <p class="kd-stat__l">{label}</p>
      </div>
    ))
  }
</div>
