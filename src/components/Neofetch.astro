---
import StatusDot from './StatusDot.astro';
import { neofetch, status } from '../i18n/common';

const palette = ['border', 'border-strong', 'border-hover', 'muted', 'text', 'accent'];
---

<div class="kd-term kd-neofetch">
  <div class="kd-term__bar"><span>neofetch</span><span>bash</span></div>
  <div class="kd-term__body">
    <div><span class="kd-term__key">orkhan</span><span class="kd-ping__muted">@</span><span class="kd-term__key">khandev</span></div>
    <div class="kd-neofetch__sep" aria-hidden="true">----------------</div>
    {
      neofetch.map((f) => (
        <div class="kd-neofetch__row">
          <span class="kd-term__key">{f.key}</span>
          <span class="kd-term__val">{f.value}</span>
        </div>
      ))
    }
    <div class="kd-neofetch__row">
      <span class="kd-term__key">status</span>
      <span class="kd-term__val kd-neofetch__status"><span class="kd-dot kd-dot--sm kd-pulse" aria-hidden="true"></span>{status}</span>
    </div>
    <div class="kd-palette" aria-hidden="true">
      {palette.map((c) => <span style={`background:var(--${c})`} />)}
    </div>
  </div>
</div>
