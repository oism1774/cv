---
import { skillMeta, skillsFooter } from '../i18n/common';

interface Props {
  items: string[];
}

const { items } = Astro.props;
const icon = { core: '[ok]', ready: '[ok]', up: '[|]' } as const;
---

<div class="kd-term">
  <div class="kd-term__bar"><span>skills.map</span><span>status</span></div>
  {
    items.map((desc, i) => {
      const s = skillMeta[i];
      return (
        <div class="kd-log__row" data-state={s.state}>
          <span class="kd-log__icon" data-spin={s.state === 'up' ? '' : undefined} aria-hidden="true">
            {icon[s.state]}
          </span>
          <span class="kd-log__name">{s.name}</span>
          <span class="kd-log__desc">{desc}</span>
          <span class="kd-log__status">{s.label}</span>
        </div>
      );
    })
  }
  <div class="kd-log__foot">{skillsFooter}<span class="kd-blink" aria-hidden="true"> _</span></div>
</div>
