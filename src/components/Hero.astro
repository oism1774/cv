---
import Button from './Button.astro';
import CvButton from './CvButton.astro';
import Icon from './Icon.astro';
import Neofetch from './Neofetch.astro';
import StatusDot from './StatusDot.astro';
import { prompt } from '../i18n/common';
import type { Dictionary } from '../i18n/types';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary['hero'];
}

const { lang, t } = Astro.props;
const [first, ...rest] = t.name.split(' ');
---

<section class="kd-hero">
  <div class="kd-hero__main">
    <p class="kd-prompt">
      <span class="kd-prompt__user">{prompt.user}</span>:<span class="kd-prompt__cmd">{prompt.path}</span>$ <span
        class="kd-prompt__cmd"
        data-type={prompt.command}>{prompt.command}</span
      ><span class="kd-cursor kd-blink" aria-hidden="true"></span>
    </p>
    <script is:inline>
      // Prompt typing: start after ~720ms, one character per 180ms. Runs inline so the full text never flashes.
      (function () {
        var el = document.querySelector('[data-type]');
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var full = el.getAttribute('data-type');
        var n = 0;
        el.textContent = '';
        setTimeout(function () {
          var id = setInterval(function () {
            el.textContent = full.slice(0, ++n);
            if (n >= full.length) clearInterval(id);
          }, 180);
        }, 720);
      })();
    </script>

    <h1 class="kd-name">{first}<br />{rest.join(' ')}</h1>
    <p class="kd-role">{t.role}</p>
    <p class="kd-tagline">{t.tagline}</p>
    <p class="kd-hero__meta"><StatusDot small /><span>{t.location}</span></p>

    <div class="kd-hero__actions">
      <CvButton lang={lang} label={t.cv} />
      <Button href="#contact" variant="outline">{t.contact}</Button>
      <span class="kd-loc"><Icon name="pin" size={14} />{t.location}</span>
    </div>
  </div>

  <Neofetch />
</section>
