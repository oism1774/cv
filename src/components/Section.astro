---
interface Props {
  id: string;
  cmd: string;
  title: string;
}

const { id, cmd, title } = Astro.props;
---

<section id={id} class="border-t border-border py-16 sm:py-20">
  <p class="font-mono text-sm text-accent">{cmd}</p>
  <h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  <div class="mt-8">
    <slot />
  </div>
</section>
