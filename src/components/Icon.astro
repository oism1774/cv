---
interface Props {
  name: 'download' | 'pin';
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'download' ? 2.2 : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'download' ? (
      <>
        <path d="M12 4v12" />
        <path d="M6 11l6 6 6-6" />
        <path d="M5 20h14" />
      </>
    ) : (
      <>
        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
</svg>
