---
import { EMAIL, WHATSAPP_URL, GITHUB_URL } from '../config';
import { ping } from '../i18n/common';

const strip = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const contacts = [
  { label: ping.labels.email, value: EMAIL, href: `mailto:${EMAIL}`, text: EMAIL },
  { label: ping.labels.whatsapp, value: WHATSAPP_URL, href: WHATSAPP_URL, text: strip(WHATSAPP_URL) },
  { label: ping.labels.github, value: GITHUB_URL, href: GITHUB_URL, text: strip(GITHUB_URL) },
].filter((c) => c.value);

const n = contacts.length;
const delays = ['.6s', '1s', '1.3s'];
---

{
  n > 0 && (
    <div class="kd-term kd-ping" data-ping>
      <div class="kd-ping__line kd-ping__muted" style="animation-delay:.2s">
        PING {ping.host}: {n} {n === 1 ? 'channel' : 'channels'}
      </div>
      {contacts.map((c, i) => (
        <div class="kd-ping__line kd-ping__reply" style={`animation-delay:${delays[i]}`}>
          <span class="kd-ping__muted kd-ping__from">{ping.replyFrom}</span>
          <span class="kd-ping__label">{c.label}</span>
          <a
            class="kd-ping__link"
            href={c.href}
            {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {c.text}
          </a>
        </div>
      ))}
      <div class="kd-ping__line kd-ping__muted" style="animation-delay:1.6s">
        --- {n} {n === 1 ? 'reply' : 'replies'}, 0% loss ---
      </div>
    </div>
  )
}

<script>
  // Lines appear one by one once the card scrolls into view.
  const card = document.querySelector<HTMLElement>('[data-ping]');
  if (card && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    card.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          card.classList.add('is-on');
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(card);
  }
</script>
