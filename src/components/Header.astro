---
import StatusDot from './StatusDot.astro';
import { languages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header class="kd-header kd-layer">
  <div class="kd-container kd-header__inner">
    <a href="#top" class="kd-logo"><span class="kd-logo__mark">&gt;_</span><span>khandev</span></a>
    <div class="kd-header__right">
      <StatusDot />
      <nav class="kd-lang" aria-label="Language">
        {
          languages.map((l) => (
            <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
              {l}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
