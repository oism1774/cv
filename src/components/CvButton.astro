---
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  label: string;
  class?: string;
}

const { lang, label, class: className } = Astro.props;
---

<Button href={`/cv/orkhan-ismayilov-cv-${lang}.pdf`} download class={className}>
  <Icon name="download" />{label}
</Button>
