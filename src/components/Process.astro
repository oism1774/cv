---
import { stepLabels } from '../i18n/common';
import type { Dictionary } from '../i18n/types';

interface Props {
  steps: Dictionary['process']['steps'];
}

const { steps } = Astro.props;
---

<div class="kd-steps">
  {
    steps.map((s, i) => (
      <div class="kd-step">
        <p class="kd-step__n">{stepLabels[i]}</p>
        <h3 class="kd-step__t">{s.title}</h3>
        <p class="kd-step__d">{s.text}</p>
      </div>
    ))
  }
</div>
