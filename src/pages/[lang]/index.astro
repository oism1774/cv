---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Badge from '../../components/Badge.astro';
import Footer from '../../components/Footer.astro';
import { dictionaries, languages, type Lang } from '../../i18n';
import { terminal, contactLabels } from '../../i18n/common';
import { EMAIL, WHATSAPP_URL, GITHUB_URL } from '../../config';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = dictionaries[lang];

const contacts = [
  { label: contactLabels.email, value: EMAIL, href: `mailto:${EMAIL}` },
  { label: contactLabels.whatsapp, value: WHATSAPP_URL, href: WHATSAPP_URL },
  { label: contactLabels.github, value: GITHUB_URL, href: GITHUB_URL },
].filter((c) => c.value);

const card = 'rounded-xl border border-border bg-card';
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} />

  <main class="mx-auto max-w-4xl px-4 sm:px-6">
    <Hero lang={lang} t={t.hero} />

    <Section id="about" cmd={terminal.about} title={t.about.title}>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">{t.about.text}</p>
    </Section>

    <Section id="experience" cmd={terminal.experience} title={t.experience.title}>
      <div class="space-y-4">
        {
          t.experience.jobs.map((job) => (
            <article class={`${card} p-5 sm:p-6`}>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="text-lg font-semibold">
                  {job.company} <span class="font-normal text-muted">- {job.role}</span>
                </h3>
                <p class="shrink-0 font-mono text-xs text-muted">{job.period}</p>
              </div>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted sm:text-[0.95rem]">
                {job.points.map((p) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-accent" aria-hidden="true">›</span>
                    <span class="min-w-0">{p}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="stack" cmd={terminal.stack} title={t.stack.title}>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          t.stack.groups.map((g) => (
            <div class={`${card} p-5`}>
              <h3 class="font-mono text-sm text-foreground">{g.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {g.tags.map((tag) => <Badge>{tag}</Badge>)}
              </div>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="learning" cmd={terminal.learning} title={t.learning.title}>
      <ul class={`${card} divide-y divide-border`}>
        {
          t.learning.items.map((item) => (
            <li class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:gap-6">
              <span class="font-mono text-sm text-accent sm:w-32 sm:shrink-0">{item.name}</span>
              <span class="text-sm text-muted sm:text-[0.95rem]">{item.value}</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="education" cmd={terminal.education} title={t.education.title}>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class={`${card} p-5`}>
          <h3 class="text-lg font-semibold">{t.education.school}</h3>
          <p class="mt-1 text-muted">{t.education.degree}</p>
          <p class="mt-3 font-mono text-xs text-muted">{t.education.period}</p>
        </div>
        <ul class={`${card} divide-y divide-border`}>
          {
            t.education.languages.map((l) => (
              <li class="flex items-center justify-between gap-4 px-5 py-3 text-sm">
                <span>{l.name}</span>
                <span class="text-right font-mono text-xs text-muted">{l.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section id="contact" cmd={terminal.contact} title={t.contact.title}>
      <p class="max-w-2xl text-lg text-muted">{t.contact.text}</p>
      {
        contacts.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {contacts.map((c) => (
              <a
                href={c.href}
                {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="inline-flex h-10 items-center rounded-md border border-border px-5 font-mono text-sm transition-colors hover:border-accent hover:text-accent"
              >
                {c.label}
              </a>
            ))}
          </div>
        )
      }
    </Section>
  </main>

  <Footer text={t.footer} />
</Base>
