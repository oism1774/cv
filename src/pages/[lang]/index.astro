---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import LearningLog from '../../components/LearningLog.astro';
import Ping from '../../components/Ping.astro';
import CvButton from '../../components/CvButton.astro';
import Footer from '../../components/Footer.astro';
import { dictionaries, languages, type Lang } from '../../i18n';
import { sections, cardCaptions } from '../../i18n/common';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = dictionaries[lang];
// Odd parts of the split are the **key phrases**.
const about = t.about.text.split('**');
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} />

  <main id="top" class="kd-container kd-layer">
    <Hero lang={lang} t={t.hero} />

    <section id="about" class="kd-section">
      <SectionHeader {...sections.about} />
      <div class="kd-about">
        <h2 class="kd-h2">{t.about.title}</h2>
        <p class="kd-lead">
          {about.map((part, i) => (i % 2 ? <span class="kd-lead__key">{part}</span> : part))}
        </p>
      </div>
    </section>

    <section id="experience" class="kd-section kd-section--experience">
      <SectionHeader {...sections.experience} />
      <h2 class="kd-h2">{t.experience.title}</h2>
      <div>
        {
          t.experience.jobs.map((job) => (
            <article class="kd-entry">
              <div class="kd-entry__when">
                <span class="kd-entry__caret" aria-hidden="true">&gt;</span>
                <span>{job.period}</span>
              </div>
              <div class="kd-entry__main">
                <h3 class="kd-entry__company">{job.company}</h3>
                <p class="kd-entry__role">{job.role}</p>
                <ul class="kd-entry__points">
                  {job.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="learning" class="kd-section">
      <SectionHeader {...sections.learning} />
      <h2 class="kd-h2">{t.learning.title}</h2>
      <LearningLog items={t.learning.items} />
    </section>

    <section id="education" class="kd-section">
      <SectionHeader {...sections.education} />
      <h2 class="kd-h2">{t.education.title}</h2>
      <div class="kd-edu">
        <div class="kd-card">
          <p class="kd-card__caption">{cardCaptions.education}</p>
          <p class="kd-card__title">{t.education.school}</p>
          <p class="kd-card__text">{t.education.degree}</p>
          <p class="kd-card__date">{t.education.period}</p>
        </div>
        <div class="kd-card">
          <p class="kd-card__caption">{cardCaptions.languages}</p>
          <ul class="kd-langs">
            {
              t.education.languages.map((l) => (
                <li>
                  <span>{l.name}</span>
                  <span class:list={['kd-langs__level', { 'kd-langs__level--native': l.native }]}>{l.value}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="contact" class="kd-section kd-section--contact">
      <SectionHeader {...sections.contact} />
      <div class="kd-contact">
        <div class="kd-contact__intro">
          <h2 class="kd-contact__title">{t.contact.title}</h2>
          <p class="kd-contact__text">{t.contact.text}</p>
          <CvButton lang={lang} label={t.hero.cv} class="kd-contact__cv" />
        </div>
        <Ping />
      </div>
    </section>
  </main>

  <Footer text={t.footer} name={t.hero.name} />
</Base>
